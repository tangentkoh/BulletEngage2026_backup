  m_EditorClassIdentifier: Assembly-CSharp::VictoryMessageSO
  messagesForOpponents:
  - "\u3010\u60AA\u304F\u306A\u3044\u7CBE\u5EA6\u306E\u653B\u6483\u3060\u3063\u305F\n\u304B\u306A\u308A\u8FFD\u3044\u8A70\u3081\u3089\u308C\u305F\u305E\u3011"
  - "\u3010\u3068\u3066\u3082\u5F37\u304F\u7DBA\u9E97\u3060\u3063\u305F\n\u8840\u306E\u6EF2\u3080\u3088\u3046\u306A\u52AA\u529B\u3092\u3057\u305F\u306E\u3060\u308D\u3046\u3011"
  - "\u3010\u3082\u3063\u3068\u5F37\u304F\u306A\u3063\u3066\u6765\u3044\n\u4E8C\u5E74\u5F8C\u306B\u30B7\u30E3\u30DC\u30F3\u30C7\u30A3\u8AF8\u5CF6\u3067\u4F1A\u304A\u3046\u3011"
  - "\u3010\u898B\u4E8B\u306A\u30C1\u30FC\u30E0\u30EF\u30FC\u30AF\u3060\u3063\u305F\n\u4E00\u4EBA\u3067\u7834\u308B\u306E\u306F\u96E3\u3057\u304B\u3063\u305F\u305E\u3011"
  - "\u3010\u975E\u5E38\u306B\u5371\u3046\u3044\u6226\u3044\u3060\u3063\u305F\n\u52DD\u3066\u305F\u306E\u306F\u904B\u304C\u826F\u304B\u3063\u305F\u3011"
  - "\u3010\u771F\u9762\u76EE\u306B\u5B66\u7FD2\u306B\u53D6\u308A\u7D44\u3080\u3068\u3044\u3044\n\u3044\u305A\u308C\u52DD\u3066\u308B\u3088\u3046\u306B\u3082\u306A\u308B\u3011"
  - "\u3010\u507D\u7269\u304C\u672C\u7269\u306B\n\u6575\u3046\u308F\u3051\u304C\u306A\u3044\u3060\u308D\u3046\u3011"
  - "\u3010\u512A\u79C0\u306A\u30A8\u30F3\u30B8\u30CB\u30A2\u3060\u3063\u305F\n\u4ECA\u5F8C\u3082\u6027\u80FD\u304C\u66F4\u65B0\u3055\u308C\u3066\u3044\u304D\u305D\u3046\u3060\u3011"
  - "\u3010\u7D20\u6674\u3089\u3057\u3044\u5C04\u6483\u6280\u8853\u3060\u3063\u305F\n\u907F\u3051\u308B\u306E\u3067\u7CBE\u4E00\u676F\u3060\u3063\u305F\u305E\u3011"
  - "\u3010\u6C17\u6301\u3061\u306F\u5206\u304B\u308B\u304C\n\u5B9F\u529B\u3060\u3051\u304C\u5168\u3066\u3067\u306F\u306A\u3044\u3060\u308D\u3046\u3011"
  defaultMessage: "\u3010\u543E\u8F29\u304C\u30D1\u30A4\u30F3\u3060\u3011"
