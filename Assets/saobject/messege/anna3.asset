  m_Name: anna3
  m_EditorClassIdentifier: Assembly-CSharp::VictoryMessageSO
  messagesForOpponents:
  - "\u3042\u306A\u305F\u63A2\u5075\u306A\u306E\uFF1F\n\u3060\u3063\u305F\u3089\u9774\u4E0B\u306E\u7247\u3063\u307D\u3092\u63A2\u3057\u3066\u307B\u3057\u3044\n\u306E\u3060\u3051\u3069\u30FB\u30FB\u30FB"
  - "\u4E00\u56DE\u9ED9\u3089\u305B\u308B\u3079\u304D\u306D\n\u3042\u306A\u305F\u306E\u3088\u3046\u306A\u6D3B\u6C17\uFF08\u3044\u304D\uFF09\u306E\u826F\u3044\u30AC\u30AD\u306F"
  - "\u3010\u30DF\u30C4\u30EB\u3011\u3092\u7099\u3063\u305F\u3089\n\u3010\u3084\u304F\u307F\u3064\u308B\u3011\u306B\u306A\u308B\u308F\u3088\uFF01"
  - "\u305D\u306E\u5B50\u72AC\u304B\u3089\u306F\u3075\u3057\u304E\u306A\u529B\u3092\u611F\u3058\u308B\u308F\n\u4ECA\u5EA6\u8ABF\u3079\u3066\u307F\u305F\u3044\u306E\u3060\u3051\u3069\u30FB\u30FB\u30FB"
  - "\u3053\u308C\u304B\u3089\u7A7A\u306E\u7BA1\u7406\u306F\u4EA4\u4EE3\u5236\u306D\n\u3042\u305F\u3057\u306F8\u6642\u9593\u3001\u3042\u306A\u305F\u304C16\u6642\u9593"
  - "\u3042\u3093\u307E\u308A\u5730\u4E0A\u306E\u98DF\u6587\u5316\u306B\u306F\u8A73\u3057\u304F\u306A\u3044\u306E\u3060\u3051\u3069\n\u305D\u308C\u306F\u300C\u30C1\u30FC\u30BA\u30E9\u30FC\u30E1\u30F3\u300D\u3058\u3083\u306A\u304F\u3066\n\u300C\u30E9\u30FC\u30E1\u30F3\u30C1\u30FC\u30BA\u300D\u3067\u306F\u306A\u3044\u306E\uFF1F"
  - "\u3069\u3061\u3089\u3082\u300C\u5EFA\u524D\u300D\u4E0A\u3001\u4EBA\u9593\u3067\u306F\u306A\u3044\u306E\u3060\u3051\u3069\u2026\n\u3042\u306A\u305F\u306F\u660E\u3089\u304B\u306B\u4EBA\u9593\u3060\u308F"
  - "\u3042\u305F\u3057\u306F\u7121\u6697\u306B\u8AB0\u304B\u3092\u50B7\u3064\u3051\u308B\u30DE\u30CD\u306F\u3057\u306A\u3044\u308F\u3088\n\u6016\u304C\u308B\u5FC5\u8981\u306F\u306A\u3044\u308F"
  - "\u3053\u3046\u3044\u3046\u5F62\u3067\u306E\u95D8\u4E89\u306B\u306A\u3063\u3066\u304B\u3089\u306F\u3001\n\u3044\u304B\u306B\u3082\u5E73\u548C\u3060\u308F"
  - "\u3042\u305F\u3057\u304C\u6075\u307E\u308C\u305F\u5074\u3063\u3066\u306E\u306F\u5206\u304B\u3063\u3066\u308B\u3051\u3069\u3001\n\u4E16\u306E\u4E2D\u5168\u3066\u304C\u904B\u30B2\u30FC\u3067\u306F\u306A\u3044\u308F\u3088"
  defaultMessage: "\u3042\u305F\u3057\u306E\u52DD\u3061\u306D"
