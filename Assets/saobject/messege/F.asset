  m_EditorClassIdentifier: Assembly-CSharp::VictoryMessageSO
  messagesForOpponents:
  - "\u904E\u53BB\u306E\u81EA\u5206\u3092\u4E57\u308A\u8D8A\u3048\u3001\nF\u306F\u6700\u5F37\u3078\u81F3\u308B"
  - "\u904B\u304C\u826F\u304B\u3063\u305F\u3060\u3051\u306E\u5F31\u8005\u3092\u4E57\u308A\u8D8A\u3048\u3001\nF\u306F\u6700\u5F37\u3078\u81F3\u308B"
  - "\u30B2\u30FC\u30E0\u306E\u3057\u3059\u304E\u3067\n\u982D\u304C\u8339\u3067\u4E0A\u304C\u3063\u305F\u30D0\u30AB\u3092\u4E57\u308A\u8D8A\u3048\u3001\nF\u306F\u6700\u5F37\u3078\u81F3\u308B"
  - "\u4E8C\u4EBA\u304C\u304B\u308A\u306E\u5351\u602F\u8005\u3092\u4E57\u308A\u8D8A\u3048\u3001\nF\u306F\u6700\u5F37\u3078\u81F3\u308B"
  - "\u5927\u3057\u305F\u3053\u3068\u3082\u306A\u3044\u5815\u5929\u4F7F\u3092\u4E57\u308A\u8D8A\u3048\u3001\nF\u306F\u6700\u5F37\u3078\u81F3\u308B"
  - "\u5358\u306A\u308B\u4E09\u4E0B\u30B3\u30A6\u30E2\u30EA\u3092\u4E57\u308A\u8D8A\u3048\u3001\nF\u306F\u6700\u5F37\u3078\u81F3\u308B"
  - "\u306A\u3081\u305F\u771F\u4F3C\u3092\u3059\u308B\u7740\u3050\u308B\u307F\u3092\u4E57\u308A\u8D8A\u3048\u3001\nF\u306F\u6700\u5F37\u3078\u81F3\u308B"
  - "\u6E29\u5BA4\u80B2\u3061\u306E\u96D1\u9B5A\u3092\u4E57\u308A\u8D8A\u3048\u3001\nF\u306F\u6700\u5F37\u3078\u81F3\u308B"
  - "\u601D\u3044\u3042\u304C\u3063\u305F\u5C0F\u60AA\u9B54\u3092\u4E57\u308A\u8D8A\u3048\u3001\nF\u306F\u6700\u5F37\u3078\u81F3\u308B"
  - "\u30CB\u30BB\u30E2\u30CE\u304C\n\u3068\u3063\u3068\u3068\u6D88\u3048\u308D\n\u30CB\u30BB\u30E2\u30CE\u304C"
  defaultMessage: "\u5F53\u7136\u306E\u7D50\u679C\u3060\u3088"
