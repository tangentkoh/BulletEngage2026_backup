  m_Name: felt3
  m_EditorClassIdentifier: Assembly-CSharp::VictoryMessageSO
  messagesForOpponents:
  - "\u3053\u308C\u304B\u3089\u306F\u52A9\u624B\u3068\u3057\u3066\u3088\u308D\u3057\u304F\n\u3082\u3046\u4E00\u4EBA\u306E\u30D5\u30A7\u30EB\u30C8\u3055\u3093"
  - "\u541B\u306F\u3082\u3046\u5C11\u3057\u3001\u5468\u308A\u3078\u306E\u914D\u616E\u3092\n\u5B66\u3093\u3060\u65B9\u304C\u3044\u3044\u3068\u601D\u3046\u3088"
  - "\u30B2\u30FC\u30E0\u5236\u4F5C\u30B5\u30FC\u30AF\u30EB\u306E\u5316\u8EAB\u3063\u3066\u3053\u3068\u306F\n\u541B\u306F\u30C9\u30E9\u30B4\u30F3\u30D1\u30F3\u30C1\u3068\u304B\n\u6483\u3066\u305F\u308A\u3059\u308B\u306E\u304B\u306A"
  - "\u30D0\u30C7\u30A3\u304C\u3044\u308B\u3063\u3066\u3044\u3044\u3053\u3068\u3060\u306D\n\u81EA\u5206\u3082\u63A2\u305D\u3046\u304B\u306A"
  - "\u541B\u306F\u5929\u306E\u4F7F\u3044\u3060\u3063\u305F\u3093\u3060\u306D\n\u30D0\u30C8\u30EB\u304C\u6210\u308A\u7ACB\u3063\u305F\u306E\u306F\u30EB\u30FC\u30EB\u3042\u308A\u304D\u304B\u306A"
  - "\u6700\u8FD1\u306F\u63A2\u5075\u3089\u3057\u3044\u3053\u3068\u3057\u3066\u306A\u3044\u306D\u3047\n\u305D\u308C\u3088\u308A\u541B\u306F\u5358\u4F4D\u3068\u304B\u5927\u4E08\u592B\u306A\u306E\u304B\u306A\uFF1F"
  - "\u3044\u304B\u306B\u3082\u7740\u3050\u308B\u307F\u307F\u305F\u3044\u3060\u3051\u3069\u3001\n\u541B\u306E\u6B63\u4F53\u3063\u3066\u4F55\u306A\u306E\uFF1F"
  - "\u541B\u306F\u30A8\u30F3\u30B8\u30CB\u30A2\u306A\u3093\u3060\u306D\n\u983C\u3093\u3060\u3089\u63A2\u5075\u9053\u5177\u3001\u4F5C\u3063\u3066\u304F\u308C\u308B\u306E\uFF1F"
  - "\u541B\u306F\u4EBA\u9593\u3058\u3083\u306A\u3044\u304B\u3089\u826F\u304F\u5206\u304B\u3089\u306A\u3044\u3051\u3069\u3001\n\u300C\u53CD\u6297\u671F\u306E\u5B50\u4F9B\u300D\u3063\u3066\u611F\u3058\u304C\u3059\u308B\u3088"
  - "\u3053\u308C\u304C\u81EA\u5206\u3060\u306A\u3093\u3066\u3001\n\u7D76\u5BFE\u306B\u8A8D\u3081\u308B\u3064\u3082\u308A\u306F\u306A\u3044\u304B\u3089\u306D"
  defaultMessage: "\u81EA\u5206\u306E\u52DD\u3061\u3060\u306D"
