  m_Script: {fileID: 11500000, guid: 060371f3bb8183746bf7798b21dd20fe, type: 3}
  m_Name: sigure3
  m_EditorClassIdentifier: Assembly-CSharp::VictoryMessageSO
  messagesForOpponents:
  - "\u76F8\u624B\u304C\u8AB0\u3067\u3082\u914D\u616E\u3059\u308B\u3064\u3082\u308A\u306F\u306A\u3044\u3067\u3059\n\u300C\u5F31\u8005\u300D\u306B\u7518\u3093\u3058\u3066\u3044\u308B\u306E\u304C\u60AA\u3044\u3093\u3067\u3059\u3088\uFF1F"
  - "\u7F8E\u5C11\u5973\u7CFB\u30A2\u30FC\u30C6\u30A3\u30B9\u30C8\u306F\n\u79C1\u3060\u3051\u3067\u5341\u5206\u3067\u3059\u3088\u30FC"
  - "\u30B2\u30FC\u30E0\u306F\u30A4\u30E9\u30B9\u30C8\u304C\u5341\u5272\u3067\u3059\n\u5D07\u3081\u3066\u3082\u3044\u3044\u3093\u3067\u3059\u3088\uFF1F"
  - "\u4E8C\u4EBA\u304C\u304B\u308A\u3067\u3082\n\u308F\u305F\u304F\u3057\u306B\u306F\u6575\u308F\u306A\u304B\u3063\u305F\u3067\u3059\u306D"
  - "\u3042\u306A\u305F\u3001\u5929\u4F7F\u3068\u3044\u3046\u8A2D\u5B9A\u306A\u3093\u3067\u3059\u306D\n\u3069\u3046\u308A\u3067\u30D5\u30EF\u30D5\u30EF\u3057\u3066\u3044\u305F\u308F\u3051\u3067\u3059"
  - "\u3042\u306A\u305F\u307F\u305F\u3044\u306A\u30AC\u30E4\u91CE\u90CE\u3068\u9055\u3063\u3066\n\u308F\u305F\u304F\u3057\u306F\u6E05\u695A\u3067\u3069\u3046\u898B\u305F\u3063\u3066\u511A\u3044\n\u7F8E\u5C11\u5973\u3067\u3059\u3088\uFF1F"
  - "\u305D\u3093\u306A\u88AB\u308A\u7269\u3092\u3057\u3066\u3001\n\u672C\u6C17\u3067\u308F\u305F\u304F\u3057\u306B\u52DD\u3066\u308B\u3068\u601D\u3063\u3066\u3044\u305F\u306E\u3067\u3059\u304B\uFF1F"
  - "\u7D76\u5999\u306B\u558B\u308A\u65B9\u88AB\u3063\u3066\u3044\u308B\u3093\u3067\u3059\u3088\u30FC\n\u6557\u5317\u8005\u3055\u3093\u306F\u3069\u3063\u304B\u884C\u3063\u3066\u4E0B\u3055\u3044"
  - "\u308F\u305F\u304F\u3057\u7A0B\u3058\u3083\u306A\u3044\u3067\u3059\u3051\u3069\u53EF\u611B\u3089\u3057\u3044\u3067\u3059\u306D\n\u304A\u59C9\u3055\u3093\u3068\u4E00\u7DD2\u306B\u5199\u771F\u3067\u3082\u64AE\u308A\u307E\u3059\u304B\uFF1F"
  - "\u305D\u3093\u306A\u59FF\u306B\u3082\u306A\u3063\u3066\u8CA0\u3051\u308B\u306A\u3093\u3066\u3001\n\u7121\u69D8\u3067\u3059\u306D\u30FC\n\u2026\u3042\u306A\u305F\u3089\u3057\u304F\u3082\u306A\u3044\u3067\u3059"
  defaultMessage: "\u308F\u305F\u304F\u3057\u306E\u52DD\u5229\u3067\u3059\uFF01"
