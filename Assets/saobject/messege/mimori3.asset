  m_Script: {fileID: 11500000, guid: 060371f3bb8183746bf7798b21dd20fe, type: 3}
  m_Name: mimori3
  m_EditorClassIdentifier: Assembly-CSharp::VictoryMessageSO
  messagesForOpponents:
  - "\u4FFA\u306F\u30CF\u30FC\u30C9\u30DC\u30A4\u30EB\u30C9\u306A\u3093\u3060\n\u898B\u305F\u76EE\u3067\u6C7A\u3081\u3064\u3051\u308B\u3093\u3058\u3083\u306A\u3044\u305C"
  - "\u9811\u5F35\u3063\u3066\u80CC\u4F38\u3073\u3057\u3066\u3044\u308B\u3088\u3046\u3060\u304C\u3001\n\u624B\u524D\u306E\u65B9\u304C\u5E74\u4E0B\u306E\u30AC\u30AD\u3060\u308D\u3046\uFF1F"
  - "\u306A\u308B\u307B\u3069\u3001\u624B\u524D\u306F\u30B2\u30FC\u30E0\u304C\u597D\u304D\u306A\u306E\u304B\n\u3060\u3063\u305F\u3089\u30ED\u30B7\u30A2\u30F3\u30EB\u30FC\u30EC\u30C3\u30C8\u3067\u3082\u3059\u308B\u304B\uFF1F"
  - "\u4E8C\u4EBA\u3067\u4E00\u4EBA\u304B\u2026\n\u4FFA\u306F\u4E00\u6614\u524D\u306B\u5B64\u9AD8\u3092\u6975\u3081\u305F\u304C\u3001\n\u305D\u3046\u3044\u3046\u306E\u3082\u826F\u3044\u304B\u3082\u306A"
  - "\u300C\u6B7B\u306C\u304B\u751F\u304D\u308B\u304B\u300D\u306E\u6226\u3044\u3082\n\u30B9\u30EA\u30EB\u304C\u3042\u3063\u3066\u826F\u304B\u3063\u305F\u3051\u3069\u306A\u3041"
  - "\u306A\u3093\u3067\u7686\u4FFA\u306E\u6027\u5225\u3092\u9593\u9055\u3048\u308B\u3093\u3060\u308D\u3046\u306A\n\u300C\u591A\u69D8\u6027\u300D\u3063\u3066\u3084\u3064\u304B\uFF1F"
  - "\u3053\u306E\u611F\u89E6\u3001\u672C\u7269\u3063\u307D\u3044\u306A\u2026\n\u7740\u3050\u308B\u307F\u3068\u304B\u3058\u3083\u306A\u3044\u306E\u304B\uFF1F\n\u4E2D\u306B\u8AB0\u3082\u3044\u306A\u3044\u306E\u304B\uFF1F"
  - "\u6226\u3063\u3066\u308B\u6642\u70B9\u3067\u8FF7\u5B50\u3067\u306F\u306A\u3044\u305E\n\u3055\u3066\u3001\u7159\u8349\uFF08\u30B7\u30AC\u30EC\u30C3\u30C8\uFF09\u3067\u3082\u8CB7\u3063\u3066\u304F\u308B\u304B"
  - "\u4FFA\u3063\u3066\u5206\u8EAB\u3067\u304D\u305F\u3093\u3060\u306A\n\u3084\u3063\u3071\u308A\u4FFA\uFF08\u672C\u4F53\uFF09\u3088\u308A\u306F\u5F31\u3044\u306E\u304B"
  - "\u4EBA\u9593\u306E\u4EBA\u751F\u306F\u77ED\u3044\u304C\u3001\u307E\u3060\u9577\u3044\u3060\u308D\u3046\uFF1F\n\u751F\u304D\u6025\u3050\u5FC5\u8981\u306F\u306A\u3044\u305C"
  defaultMessage: "\u4FFA\u306F\u65E9\u3044\u305C\u2026"
