  m_Name: nana3
  m_EditorClassIdentifier: Assembly-CSharp::VictoryMessageSO
  messagesForOpponents:
  - "\u3044\u3044\u3067\u3057\u3087\u30FC\u76F8\u68D2\u3063\u3066\uFF01\n\u30AD\u30DF\u3082\u63A2\u3057\u3066\u307F\u305F\u3089\uFF1F"
  - "\u3055\u3059\u304C\u306B\u30C7\u30EA\u30AB\u30B7\u30FC\u304C\u7121\u3055\u3059\u304E\u308B\u3088\n\u3082\u3057\u304B\u3057\u3066\u53CB\u9054\u3044\u306A\u3044\u3093\u3058\u3083\u306A\u3044\u306E\uFF1F"
  - "\u9060\u9694\u64CD\u4F5C\u578B\u3058\u3083\u306A\u3044\u3088\u30FC\n\u30CF\u30C1\u306F\u7ACB\u6D3E\u306A\u3075\u3057\u304E\u305B\u3044\u3076\u3064\u3060\u3088\uFF1F"
  - "\u30AD\u30DF\u3082\u7D20\u6575\u306A\u76F8\u68D2\u304C\u3044\u308B\u3093\u3060\u306D\n\u4ECA\u56DE\u306F\u79C1\u305F\u3061\u306E\u52DD\u3061\u3060\u3063\u305F\u3051\u3069\u306D\uFF01"
  - "\u4EBA\u9593\u4EE5\u5916\u3068\u3084\u308A\u3042\u3046\u3053\u3068\u3082\n\u7D50\u69CB\u3042\u308B\u3093\u3060\u3088\u306D\u30FC\n\u79C1\u305F\u3061\u304C\u8A00\u3048\u305F\u3053\u3068\u3058\u3083\u306A\u3044\u304B\u3082\u3060\u3051\u3069"
  - "\u3082\u3057\u304B\u3057\u3066\u52D5\u7269\u5DEE\u5225\u5BB6\u3060\u3063\u305F\u308A\u3059\u308B\uFF1F\n\u7136\u308B\u3079\u304D\u6A5F\u95A2\u306B\u8A34\u3048\u3061\u3083\u3046\u3088\u30FC"
  - "\u3053\u3093\u306A\u898B\u305F\u76EE\u306E\u5996\u7CBE\u304C\u3044\u308B\u308F\u3051\u306A\u3044\uFF01\n\u30AD\u30DF\u306F\u591A\u5206\u7740\u3050\u308B\u307F\u3060\u3088\u306D\uFF1F"
  - "\u3044\u304B\u306B\u3082\u304A\u5B22\u69D8\u307F\u305F\u3044\u3060\u306D\uFF01\n\u3061\u3087\u3063\u3068\u61A7\u308C\u3061\u3083\u3046\u306A\u30FC"
  - "\u306A\u3093\u3067\u7121\u7406\u306B\u5927\u4EBA\u3076\u3063\u3066\u308B\u306E\uFF1F\n\u898B\u305F\u76EE\u306F\u5B50\u4F9B\u307F\u305F\u3044\u306A\u306E\u306B"
  - "\u9811\u5F35\u3063\u305F\u7D50\u679C\u5931\u6557\u3059\u308B\u306E\u306F\u3001\u5225\u306B\u666E\u901A\u306E\u3053\u3068\u3060\u3088\n\u305D\u306E\u5F8C\u304C\u5927\u4E8B\u306A\u3093\u3058\u3083\u306A\u3044\u304B\u306A\uFF1F"
  defaultMessage: "\u79C1\u305F\u3061\u306E\u52DD\u3061\u3060\u3088\u30FC\uFF01"
