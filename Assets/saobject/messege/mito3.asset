  m_EditorClassIdentifier: Assembly-CSharp::VictoryMessageSO
  messagesForOpponents:
  - "\u30A2\u30CA\u30BF\u3001\u63A2\u5075\u306E\u5272\u306B\u306F\n\u8776\u30CD\u30AF\u30BF\u30A4\u3068\u304B\u9EBB\u9154\u9283\u3092\n\u4F7F\u308F\u306A\u3044\u3067\u3059\u306E\u306D"
  - "\u3053\u3044\u3064\u3001\u6027\u683C\u60AA\u3059\u304E\u3067\u3059\n\u8DDD\u96E2\u3092\u7F6E\u304F\u3053\u3068\u306B\u3057\u307E\u3059\u308F\u30FC"
  - "\u9060\u76EE\u304B\u3089\u898B\u3066\u308B\u5206\u306B\u306F\u9762\u767D\u3044\u3067\u3059\u3051\u3069\u3001\n\u30A2\u30CA\u30BF\u3068\u3044\u308B\u3068\u5384\u707D\u306B\u5DFB\u304D\u8FBC\u307E\u308C\u305D\u3046\u3067\u3059\u308F\u2026"
  - "\u30EF\u30BF\u30B7\u306E\u5BB6\u306F\u305D\u3053\u305D\u3053\u5927\u304D\u3044\u3067\u3059\u3051\u3069\u3001\n\u52D5\u7269\u306F\u98FC\u3063\u3066\u3044\u306A\u3044\u3067\u3059\u308F\n\u8CAC\u4EFB\u3092\u53D6\u308C\u308B\u6C17\u304C\u3057\u306A\u3044\u306E\u3067"
  - "\u660E\u3089\u304B\u306B\u5F37\u305D\u3046\u306A\u4EBA\u3067\u3057\u305F\u2026\n\u4ECA\u306E\u3046\u3061\u306B\u52DD\u3061\u9003\u3052\u3059\u308B\u3057\u304B\u306A\u3044\u3067\u3059\u308F\u306D"
  - "\u3069\u3046\u3084\u3063\u305F\u3089\u3001\u30B7\u30E3\u30EB\u30ED\u30C3\u30C8\u3055\u3093\u306E\u3088\u3046\u306B\n\u4E01\u5EA6\u3044\u3044\u4EBA\u4ED8\u304D\u5408\u3044\u304C\u3067\u304D\u308B\u306E\u3067\u3057\u3087\u3046\u2026"
  - "\u3069\u3046\u898B\u3066\u3082\u7740\u3050\u308B\u307F\u307F\u305F\u3044\u3067\u3059\u3051\u3069\u3001\n\u3042\u307E\u308A\u89E6\u308C\u306A\u3044\u65B9\u304C\u3088\u308D\u3057\u3044\u306E\u3067\u3057\u3087\u3046\u304B\uFF1F"
  - "\u3053\u3053\u307E\u3067\u305D\u3063\u304F\u308A\u306B\u3067\u304D\u308B\u306A\u3093\u3066\u3001\n\u6700\u8FD1\u306E\u6280\u8853\u306F\u3059\u3054\u3044\u3067\u3059\u308F\u306D"
  - "\u3042\u306E\u30FC\u3001\u8FF7\u5B50\u3067\u3059\u304B\uFF1F\n\u3082\u3057\u826F\u304B\u3063\u305F\u3089\u6848\u5185\u3057\u307E\u3059\u308F"
  - "\u4E16\u306E\u4E2D\u3048\u3052\u3064\u306A\u3044\u4EBA\u306F\u3048\u3052\u3064\u306A\u3044\u306E\u3067\u3059\n\u30EF\u30BF\u30B7\u305F\u3061\u306F\u52AA\u529B\u3067\u57CB\u3081\u308B\u3057\u304B\u306A\u3044\u306E\u3067\u3059\u308F"
  defaultMessage: "\u30EF\u30BF\u30B7\u306E\u52DD\u3061\u3067\u3059\u308F\u30FC"
