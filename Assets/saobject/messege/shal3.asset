  m_Script: {fileID: 11500000, guid: 060371f3bb8183746bf7798b21dd20fe, type: 3}
  m_Name: shal3
  m_EditorClassIdentifier: Assembly-CSharp::VictoryMessageSO
  messagesForOpponents:
  - "\u3042\u3093\u305F\u63A2\u5075\u306A\u306E\uFF1F\n\u30AB\u30C3\u30B3\u3064\u3051\u305F\u30A4\u30E1\u30FC\u30B8\u304C\u3042\u308B\u3051\u3069\u3001\n\u5B9F\u969B\u306B\u306F\u6D6E\u6C17\u8ABF\u67FB\u3070\u3063\u304B\u308A\u3060\u3063\u3066\u805E\u304F\u3088\uFF1F"
  - "\u3042\u3093\u305F\u307F\u305F\u3044\u306A\u81EA\u5C0A\u5FC3\u306E\u30AB\u30BF\u30DE\u30EA\u3001\n\u5929\u4F7F\u3067\u3082\u60AA\u9B54\u3067\u3082\u6271\u3044\u304D\u308C\u306D\u30FC\u308F\uFF01"
  - "\u300C\u6B8B\u5FF5\u300D\u3060\u3063\u305F\u306A\uFF01\n\u3053\u306E\u5F3E\u5E55\u30B2\u30FC\u3067\u306F\u30A6\u30C1\u306E\u65B9\u304C\u5F37\u304B\u3063\u305F\uFF01"
  - "\u6240\u8A6E\u306F\u30EF\u30F3\u3061\u3083\u3093\u3058\u3083\u3093\n\u3055\u3059\u304C\u306B\u30D2\u30C8\u306B\u52DD\u3064\u306E\u306F\u96E3\u3057\u304B\u3063\u305F\u3093\u3058\u3083\u306A\u3044\uFF1F"
  - "\u3042\u3093\u305F\u3063\u3066\u30E9\u30FC\u30E1\u30F3\u98DF\u3079\u305F\u3053\u3068\u3042\u308B\uFF1F\n\u6687\u3060\u3063\u305F\u3089\u98DF\u3079\u306B\u884C\u304B\u306A\u3044\uFF1F"
  - "\u4E16\u754C\u306B\u306F\u305D\u3063\u304F\u308A\u3055\u3093\u304C\u4E09\u4EBA\u3044\u308B\u3089\u3057\u3044\u3051\u3069\u3001\n\u3053\u3053\u307E\u3067\u4F3C\u308B\u3053\u3068\u3082\u3042\u308B\u3093\u3060\u306A"
  - "\u4ECA\u3069\u304D\u305D\u3093\u306A\u683C\u597D\u3059\u308B\u3060\u3051\u3058\u3083\n\u30CD\u30C3\u30C8\u3067\u30D0\u30B9\u308C\u306D\u30FC\u3088\uFF01"
  - "\u3069\u3046\u3084\u3063\u305F\u3089\u7F8E\u90FD\u306E\u3088\u3046\u306B\n\u5468\u308A\u304B\u3089\u4E01\u5EA6\u3044\u3044\u6271\u308F\u308C\u65B9\u3092\n\u3057\u3066\u3082\u3089\u3048\u308B\u3093\u3060\u308D\u3046\u306A\u2026"
  - "\u30A6\u30C1\u306F\u9A19\u3055\u308C\u306A\u3044\u304B\u3089\u306A\n\u4E2D\u6027\u7684\u3060\u304B\u3089\u3063\u3066\u9A19\u3055\u308C\u306A\u3044\u304B\u3089\u306A"
  - "\u4E2D\u4E8C\u75C5\u3092\u901A\u308A\u8D8A\u3057\u3066\u3044\u306A\u3044\u304B\uFF1F\n\u6D41\u77F3\u306B\u30C9\u30F3\u5F15\u304D\u3060\u3088\u2026"
  defaultMessage: "\u30A6\u30C1\u306E\u304B\u3061\u3060\u306A\uFF01"
